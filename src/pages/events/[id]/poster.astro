---
// A fixed-size poster (1080 × 1350, the portrait format WeChat and Instagram
// prefer) rendered from the event record. The poster workflow screenshots
// this route with Playwright; coordinators can also print it from a browser.
// Local styles and artwork keep the poster independent of external services.
import { getCollection } from 'astro:content';
import Mark from '../../../components/Mark.astro';
import BlueHourArt from '../../../components/BlueHourArt.astro';
import { network } from '../../../lib/network';
import { absolute } from '../../../lib/url';
import { formatDate, type EventEntry } from '../../../lib/events';
import { labName, publishedLab } from '../../../lib/labs';
import { EVENT_TYPE_LABELS } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.data.draft && e.data.poster);
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: EventEntry;
}
const { event } = Astro.props;
const d = event.data;
const hostLab = await publishedLab(d.host_lab);
const host = hostLab ? `${labName(hostLab)} · ${hostLab.data.institution_short ?? hostLab.data.institution}` : d.host_institution;
const dateLine = d.end_date
  ? `${formatDate(d.date, { year: undefined })} – ${formatDate(d.end_date)}`
  : formatDate(d.date, { weekday: 'long', month: 'long' });
const timeLine = d.start ? `${d.start}${d.end ? `–${d.end}` : ''} Hong Kong Time` : '';
const link = absolute(`events/${event.id}/`);
const titleSize = d.title.length > 90 ? 46 : d.title.length > 60 ? 54 : 64;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Poster · {d.title}</title>
    <style define:vars={{ titleSize: `${titleSize}px` }}>
      html,
      body {
        margin: 0;
        background: #eee4ff;
      }
      .poster {
        width: 1080px;
        height: 1350px;
        margin: 0 auto;
        background: #eee4ff;
        color: #291333;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial,
          "Noto Sans", "PingFang SC", "Microsoft YaHei", sans-serif;
        display: flex;
        flex-direction: column;
        padding: 0 88px 80px;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
      }
      .band {
        height: 10px;
        margin: 0 -88px 72px;
        background: linear-gradient(90deg, #6a32ed, #dafb50, #ff7366);
      }
      .net {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 28px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .net :global(.brand-mark) {
        width: 44px;
        height: 44px;
        flex: none;
        color: #6a32ed;
      }
      .net small {
        display: block;
        font-size: 20px;
        font-weight: 400;
        color: #5f476e;
        margin-top: 4px;
      }
      .type {
        margin-top: 120px;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #6a32ed;
      }
      h1 {
        font-size: var(--titleSize);
        line-height: 1.1;
        margin: 22px 0 0;
        font-weight: 600;
        letter-spacing: -0.02em;
        max-width: 880px;
      }
      .speaker {
        margin-top: 48px;
        font-size: 40px;
        font-weight: 500;
      }
      .aff {
        font-size: 28px;
        color: #5f476e;
        margin-top: 6px;
      }
      .junior {
        margin-top: 26px;
        font-size: 24px;
        color: #5f476e;
      }
      /* Takes whatever height is left between the text and the date, so the
         artwork can never overlap a long title or speaker block. */
      .spacer {
        flex: 1 1 auto;
        min-height: 40px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 36px 0 24px;
        overflow: hidden;
      }
      .spacer :global(.raster) {
        width: 520px;
        height: 200px;
        opacity: 0.5;
      }
      .when {
        font-size: 34px;
        font-weight: 600;
        position: relative;
      }
      .when div + div {
        margin-top: 6px;
        font-size: 28px;
        font-weight: 400;
        color: #5f476e;
      }
      .foot {
        margin-top: 44px;
        padding-top: 24px;
        border-top: 1px solid #bba7cd;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 22px;
        color: #5f476e;
        gap: 40px;
        position: relative;
      }
      .foot .link {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 20px;
        word-break: break-all;
      }
      @media print {
        html,
        body {
          background: #fff;
        }
        @page {
          size: 1080px 1350px;
          margin: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="poster">
      <div class="band"></div>
      <div class="net">
        <Mark size={44} />
        <span>
          {network.short_name}
          <small>{network.name}{network.name_native ? ` · ${network.name_native}` : ''}</small>
        </span>
      </div>
      <div class="type">{EVENT_TYPE_LABELS[d.type]}</div>
      <h1>{d.title}</h1>
      {d.speaker && (
        <div class="speaker">
          {d.speaker}
          {d.speaker_native && <span> {d.speaker_native}</span>}
        </div>
      )}
      {d.speaker_affiliation && <div class="aff">{d.speaker_affiliation}</div>}
      {d.junior_speaker && (
        <div class="junior">
          Junior talk: {d.junior_speaker.name}
          {d.junior_speaker.affiliation && `, ${d.junior_speaker.affiliation}`}
        </div>
      )}
      <div class="spacer">
        <BlueHourArt class="raster" />
      </div>
      <div class="when">
        <div>{dateLine}</div>
        {timeLine && <div>{timeLine}</div>}
        <div>
          {d.location}
          {d.platform && ` · ${d.platform}`}
        </div>
      </div>
      <div class="foot">
        <div>{host ? `Hosted by ${host}` : network.short_name}</div>
        <div class="link">{link.replace(/^https?:\/\//, '')}</div>
      </div>
    </div>
  </body>
</html>
