---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { network } from '../../../lib/network';
import { url, absolute } from '../../../lib/url';
import { formatWhen, speakerLine, isUpcoming, eventStart, eventEnd, type EventEntry } from '../../../lib/events';
import { labName, publishedLab } from '../../../lib/labs';
import { EVENT_TYPE_LABELS } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.data.draft);
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: EventEntry;
}
const { event } = Astro.props;
const d = event.data;
const { Content } = await render(event);
const hostLab = await publishedLab(d.host_lab);
const host = hostLab ? `${labName(hostLab)}, ${hostLab.data.institution}` : d.host_institution;
const upcoming = isUpcoming(event);
const description = [EVENT_TYPE_LABELS[d.type], speakerLine(event), formatWhen(event)].filter(Boolean).join(' · ');
const rec = d.recording;

const online = d.location.toLowerCase().includes('online');
const pageUrl = absolute(`events/${event.id}/`);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.title,
  startDate: eventStart(event).toISOString(),
  endDate: eventEnd(event).toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: online ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/MixedEventAttendanceMode',
  location: online
    ? { '@type': 'VirtualLocation', url: pageUrl }
    : { '@type': 'Place', name: d.location },
  organizer: { '@type': 'Organization', name: network.name, url: absolute('') },
  ...(d.speaker
    ? {
        performer: {
          '@type': 'Person',
          name: d.speaker,
          ...(d.speaker_affiliation ? { affiliation: { '@type': 'Organization', name: d.speaker_affiliation } } : {}),
          ...(d.speaker_url ? { url: d.speaker_url } : {}),
        },
      }
    : {}),
  description: (event.body ?? '').trim().slice(0, 500),
  url: pageUrl,
  isAccessibleForFree: true,
};
---

<Base title={d.title} description={description} jsonld={jsonld}>
  <article class="prose">
    <p class="small"><a href={url('events/')}>← Seminars</a></p>
    <span class="tag accent">{EVENT_TYPE_LABELS[d.type]}</span>
    {!upcoming && <span class="tag"> · Past</span>}
    <h1>{d.title}</h1>
    {speakerLine(event) && (
      <p class="lead" style="margin-bottom:0.4rem">
        {d.speaker_url ? <a href={d.speaker_url}>{d.speaker}</a> : d.speaker}
        {d.speaker_native && <span> {d.speaker_native}</span>}
        {d.speaker_affiliation && <span>, {d.speaker_affiliation}</span>}
      </p>
    )}
    <p style="font-weight:600">{formatWhen(event)}</p>

    <dl class="facts">
      <dt>Where</dt>
      <dd>
        {d.location}
        {d.platform && ` · ${d.platform}`}
        {upcoming && d.location.toLowerCase().includes('online') && (
          <span class="muted small"> · link on the announcement list</span>
        )}
      </dd>
      {host && (
        <>
          <dt>Host</dt>
          <dd>{host}</dd>
        </>
      )}
      {d.junior_speaker && (
        <>
          <dt>Junior talk</dt>
          <dd>
            {d.junior_speaker.name}
            {d.junior_speaker.affiliation && `, ${d.junior_speaker.affiliation}`}
            {d.junior_speaker.title && <span class="muted"> · {d.junior_speaker.title}</span>}
          </dd>
        </>
      )}
      {d.registration_url && (
        <>
          <dt>Register</dt>
          <dd><a href={d.registration_url}>{d.registration_url}</a></dd>
        </>
      )}
      {(rec?.bilibili || rec?.youtube || rec?.other) && (
        <>
          <dt>Recording</dt>
          <dd>
            {[
              rec?.bilibili && { href: rec.bilibili, label: 'Bilibili' },
              rec?.youtube && { href: rec.youtube, label: 'YouTube' },
              rec?.other && { href: rec.other, label: 'Recording' },
            ]
              .filter((x): x is { href: string; label: string } => Boolean(x))
              .map((x, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={x.href}>{x.label}</a>
                </>
              ))}
          </dd>
        </>
      )}
      {(d.slides_url || d.materials_url) && (
        <>
          <dt>Materials</dt>
          <dd>
            {d.slides_url && <a href={d.slides_url}>Slides</a>}
            {d.slides_url && d.materials_url && ' · '}
            {d.materials_url && <a href={d.materials_url}>Materials</a>}
          </dd>
        </>
      )}
    </dl>

    <Content />

    <div class="actions">
      <a class="btn small" href={url('calendar.ics')}>Add the series to your calendar</a>
      <a class="btn small" href={url(`events/${event.id}/poster/`)}>Poster</a>
    </div>
    {network.seminar.recording_note && <p class="small muted" style="margin-top:1.5rem">{network.seminar.recording_note}</p>}
  </article>
</Base>
