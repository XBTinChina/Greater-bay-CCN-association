---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { network, forms, routes, slotLine } from '../../lib/network';
import { url } from '../../lib/url';
import { publishedEvents, isUpcoming, byDateAsc, byDateDesc } from '../../lib/events';

const events = await publishedEvents();
const upcoming = events.filter((e) => isUpcoming(e)).sort(byDateAsc);
const past = events.filter((e) => !isUpcoming(e)).sort(byDateDesc);

const byYear = new Map<number, typeof past>();
for (const e of past) {
  const y = e.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), e]);
}
---

<Base title="Events" description="The seminar series and other regional events: upcoming and past, with recordings.">
  <h1>Events</h1>
  <p class="lead">
    The seminar series and other regional events. {slotLine}, on {network.seminar.platform}. Meeting links go to
    the announcement list, not this page.
  </p>
  <div class="actions" style="margin-top:0.5rem">
    <a class="btn small" href={routes.follow}>Follow the seminars</a>
    <a class="btn small" href={url('calendar.ics')}>Calendar feed</a>
    <a class="btn small" href={routes.nominateEmail || forms.nomination}>Nominate a speaker</a>
    <a class="btn small" href={forms.event}>Propose an event</a>
    <a class="btn small" href={url('docs/speaker-kit/')}>For speakers</a>
  </div>

  <h2 id="upcoming">Upcoming</h2>
  {upcoming.length > 0 ? (
    <ul class="rows">
      {upcoming.map((e, i) => <EventRow event={e} featured={i === 0} />)}
    </ul>
  ) : (
    <p class="quiet">Nothing scheduled yet. The first talk will appear here and in the calendar feed.</p>
  )}

  <h2 id="past">Past</h2>
  {past.length === 0 && <p class="muted">No past events yet.</p>}
  {[...byYear.entries()].map(([year, list]) => (
    <section>
      <h3 class="muted">{year}</h3>
      <ul class="rows">
        {list.map((e) => <EventRow event={e} />)}
      </ul>
    </section>
  ))}
</Base>
