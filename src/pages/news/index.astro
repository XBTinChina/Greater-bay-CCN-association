---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/events';

const entries = (await getCollection('news', (n) => !n.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const items = await Promise.all(entries.map(async (n) => ({ n, Content: (await render(n)).Content })));
---

<Base title="News" description="Announcements from the network.">
  <h1>News</h1>
  {items.length === 0 && <p class="muted">Nothing yet.</p>}
  <div>
    {items.map(({ n, Content }) => (
      <article class="entry" id={n.id}>
        <h2>{n.data.title}</h2>
        <div class="meta">{formatDate(n.data.date, { weekday: undefined })}</div>
        <div class="prose"><Content /></div>
      </article>
    ))}
  </div>
</Base>
