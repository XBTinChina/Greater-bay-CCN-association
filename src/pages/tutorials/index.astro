---
// Training material moved to the Resources page. This stub keeps old links working.
import { url, absolute } from '../../lib/url';
const target = url('resources/#training');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absolute('resources/')} />
    <title>Moved</title>
  </head>
  <body>
    <p>Training material is now under <a href={target}>Resources</a>.</p>
  </body>
</html>
