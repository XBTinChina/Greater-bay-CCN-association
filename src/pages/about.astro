---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { network, forms, routes, founding, slotLine } from '../lib/network';
import { url } from '../lib/url';
import { publishedLabs, institutionsOf } from '../lib/labs';
import Mark from '../components/Mark.astro';

const labs = await publishedLabs();
const institutions = institutionsOf(labs.filter((l) => l.data.tier === 'member'));

// Colour-code affiliation and role. The hue is the value's position in the
// list of distinct values, not a hash of its text, so two institutions can
// never land on the same colour while there are six or fewer of them. Same
// institution, same hue: that is the one thing colour says here that the words
// do not. Roles start half a palette along to distinguish affiliation and role.
const HUES = 6;
const distinct = (key: 'institution' | 'role') => [...new Set(network.coordinators.map((c) => c[key]))];
const affs = distinct('institution');
const roles = distinct('role');
const hue = (list: string[], value: string, offset = 0) => (list.indexOf(value) + offset) % HUES;

const reachable = network.coordinators.filter((c) => c.email);
const docs = (await getCollection('docs', (d) => !d.data.draft && d.data.audience === 'public')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'en'),
);
---

<Base title="About" description={network.mission}>
  <h1>About</h1>
  <div class="about-identity">
    <Mark size={64} />
    <div>
      <strong>{network.acronym}</strong>
      <p>{network.name}</p>
      {network.name_native && <p lang="zh">{network.name_native}</p>}
    </div>
  </div>
  <div class="prose">
    <p class="lead">{network.mission}</p>
    <p>
      The network is an informal collaboration among labs, with no membership fees. Member labs host seminars,
      maintain a shared lab directory and share learning resources. The network is not a separate legal entity.
      Any change to that arrangement would be discussed by the member labs and recorded in the charter.
    </p>

    <h2>Our purpose</h2>
    <p>
      Connecting labs across campuses makes it easier to meet colleagues, share methods and invite speakers.
      We aim to complement existing groups and societies and support collaboration across the Greater Bay Area.
    </p>

    <h2>Language</h2>
    <p>
      English is the usual working language for shared events. Names in other scripts are welcome alongside Latin-script names,
      and learning resources may be shared in any language with a clear language label.
      Please contact the organisers before an event with any language or access needs.
    </p>

    <h2>How it runs</h2>
    {network.seminar.proposed && (
      <p class="small muted">Proposed arrangements, subject to confirmation by the member labs.</p>
    )}
    {founding && (
      <p class="small muted">
        The <a href={url('docs/charter/')}>charter</a> is a draft for ratification by the member labs.
      </p>
    )}
    <dl class="facts">
      <dt>Seminars</dt>
      <dd>{slotLine}. Usually online on {network.seminar.platform}{network.seminar.fallback_platform ? `, with ${network.seminar.fallback_platform} as a backup` : ''}. Check each event page for the confirmed date, time and platform.</dd>
      <dt>Hosts</dt>
      <dd>Member labs take turns inviting the speaker, chairing the seminar and sharing the meeting link with participants.</dd>
      <dt>Coordinators</dt>
      <dd>Coordinators manage the seminar schedule, review submissions and maintain the website and repository. Interim coordinators share this work during the founding stage. The draft charter proposes rotating terms, with one person per institution where possible.</dd>
      <dt>Membership</dt>
      <dd>Member labs are based in the Greater Bay Area. Affiliate labs participate from elsewhere. Coordinators review both before listing.</dd>
      <dt>Keeping entries current</dt>
      <dd>Labs can request an update or removal. Coordinators ask labs to confirm their details each year. See the <a href={url('docs/member-guidelines/')}>member lab guidelines</a>.</dd>
      <dt>Public records</dt>
      <dd>The lab directory, event listings, charter and website are stored in a public repository. Proposed changes are reviewed before publication.</dd>
    </dl>
  </div>

  <h2>Coordinators</h2>
  {network.coordinators.length === 0 ? (
    <p class="muted">To be announced.</p>
  ) : (
    <>
      <ul class="conveners">
        {network.coordinators.map((c) => (
          <li>
            <div class="who">
              {c.url ? <a href={c.url}>{c.name}</a> : c.name}
              {c.name_native && <span class="muted"> {c.name_native}</span>}
            </div>
            <div class="chips">
              <span class={`chip aff hue-${hue(affs, c.institution)}`}>{c.institution}</span>
              <span class={`chip role hue-${hue(roles, c.role, HUES / 2)}`}>{c.role}</span>
            </div>
            {c.role_detail && <p class="small muted">{c.role_detail}</p>}
          </li>
        ))}
      </ul>
      <details class="contacts">
        <summary>Email addresses</summary>
        {reachable.length > 0 && (
          <dl class="facts">
            {reachable.map((c) => (
              <>
                <dt>{c.name}</dt>
                <dd><a href={`mailto:${c.email}`}>{c.email}</a></dd>
              </>
            ))}
          </dl>
        )}
        <p class="small muted">
          You can <a href={forms.issues}>open a GitHub issue</a> for a public suggestion or correction.
          Issues are visible to everyone. Send private matters directly to a coordinator.
        </p>
      </details>
    </>
  )}
  {founding && (
    <p class="small muted">This list is updated as coordinators confirm their participation.</p>
  )}

  {institutions.length > 0 && (
    <>
      <h2>Institutions of participating labs</h2>
      <ul class="inline-list">
        {institutions.map((i) => <li title={i.city}>{i.name}</li>)}
      </ul>
      {network.host_institutions.length > 0 && (
        <p class="small muted" style="margin-top:0.75rem">Seminar series co-hosted by {network.host_institutions.join(', ')}.</p>
      )}
    </>
  )}

  <h2>Documents</h2>
  {docs.length === 0 ? (
    <p class="muted">No documents are listed yet.</p>
  ) : (
    <dl class="facts">
      {docs.map((d) => (
        <>
          <dt><a href={url(`docs/${d.id}/`)}>{d.data.title}</a></dt>
          <dd>{d.data.summary ?? ''}</dd>
        </>
      ))}
    </dl>
  )}
  <p class="small"><a href={url('docs/')}>All documents, including coordinator handbooks</a></p>

  <h2>Contact</h2>
  <p>
    {network.contact_email ? (
      <>
        <a href={`mailto:${network.contact_email}`}>{network.contact_email}</a>.
      </>
    ) : (
      <>
        For a public enquiry, <a href={forms.issues}>open a GitHub issue</a> or contact a member lab.
        Contact a coordinator directly for private matters.
      </>
    )}
  </p>
  <p>
    {network.mailing_list_url ? (
      <><a href={network.mailing_list_url}>Subscribe to GBA-CCN Network Updates</a> for seminars, events, open positions and network news.
        Subscription is optional, needs no GitHub account, and you can unsubscribe from any newsletter email.</>
    ) : network.contact_email ? (
      <>To receive news about seminars, events and open positions, <a href={routes.followEmail}>send a short email</a>.</>
    ) : (
      <>Contact a member lab for the announcement list and seminar joining details.</>
    )}
  </p>
</Base>
