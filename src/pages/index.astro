---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { Image } from 'astro:assets';
import neuralTides from '../assets/brand/neural-tides.webp';
import GreaterBayMap from '../components/GreaterBayMap.astro';
import LabCard from '../components/LabCard.astro';
import Shuffle from '../components/Shuffle.astro';
import EventRow from '../components/EventRow.astro';
import { network, routes, founding, slotLine } from '../lib/network';
import { url, absolute } from '../lib/url';
import { publishedLabs, institutionsOf, citiesOf } from '../lib/labs';
import { GBA_CITIES } from '../lib/taxonomy';
import { publishedEvents, isUpcoming, byDateAsc, byDateDesc, formatDate, formatWhen, ymd, speakerLine } from '../lib/events';

const labs = await publishedLabs();
const members = labs.filter((l) => l.data.tier === 'member');
const institutions = institutionsOf(members);
// Two different claims, so two different lists. The regional section lists
// the network covers, which is every Greater Bay Area city whether or not a lab
// has joined from it yet: a PI in Foshan should see Foshan and know they
// qualify. The founding note below states where labs actually are, so it reads
// off the roster and cannot name a city with no lab in it.
// A no-break space before each separator keeps the "·" with the city it
// follows, so a wrapped line never opens on a stray dot.
const cityLine = (GBA_CITIES as readonly string[]).join('\u00A0· ');
const cities = citiesOf(members);
// en-GB, not en: the rest of the site is British-spelled, and en would add a
// serial comma ("Hong Kong, Macau, and Zhuhai").
const citySentence = new Intl.ListFormat('en-GB', { style: 'long', type: 'conjunction' }).format(cities);

const events = await publishedEvents();
const upcoming = events.filter((e) => isUpcoming(e)).sort(byDateAsc);
const nextEvent = upcoming[0];
const past = events.filter((e) => !isUpcoming(e)).sort(byDateDesc);
const talksHeld = past.filter((e) => e.data.type === 'seminar').length;
const recentSpeakers = past.filter((e) => e.data.speaker).slice(0, 6);

// Every lab is rendered, and CSS shows only the first HOME_LABS of them. The
// client-side shuffle then decides which those are, so front-page exposure
// rotates on every visit instead of rewarding whoever joined most recently.
// Cards beyond the cut cost a little markup and no images (they are lazy and
// display:none), which is a fair trade at this size; revisit if the roster ever
// reaches the hundreds.
const showcase = [...labs].sort((a, b) => a.data.pi.localeCompare(b.data.pi, 'en'));
const news = (await getCollection('news', (n) => !n.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);

// Keep the name in the network settings as the source of truth. The three
// visual groups express place, field and community without changing the name.
const titleParts = network.name.match(/^(Greater Bay Area) (.+) (Network)$/);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: network.name,
  alternateName: [network.acronym, network.short_name, network.name_native].filter(Boolean),
  url: absolute(''),
  logo: absolute('logo.svg'),
  description: network.tagline,
  areaServed: 'Guangdong-Hong Kong-Macao Greater Bay Area',
  sameAs: [network.repo_url],
  ...(network.contact_email ? { email: network.contact_email } : {}),
};
---

<Base hideBanner home jsonld={jsonld}>
  <section class="home-hero" aria-labelledby="network-title">
    <div class="home-intro">
      <p class="home-eyebrow">A Greater Bay Area network, open to the world</p>
      <h1 id="network-title" class="network-title">
        {titleParts ? (
          <>
            <span class="network-region">{titleParts[1]}</span>{' '}
            <span>{titleParts[2]}</span>{' '}
            <span class="network-community">{titleParts[3]}</span>
          </>
        ) : network.name}
      </h1>
      <p class="home-slogan">Brains. Models. <em>People.</em></p>
      <p class="home-description"><strong>We welcome researchers from the Greater Bay Area and around the world.</strong> Labs outside the region can <a href={url('join/')}>join as affiliates</a>.</p>
      <div class="actions">
        <a class="btn primary" href={url('events/')}>Explore seminars ↗</a>
        <a class="btn" href={routes.follow} aria-describedby={network.mailing_list_url ? 'newsletter-description' : undefined}>{network.mailing_list_url ? 'Subscribe to newsletter' : 'Follow the seminars'}</a>
      </div>
      {network.mailing_list_url && <p id="newsletter-description" class="home-newsletter">Get seminars, events, open positions and network news in your inbox.</p>}
    </div>
    <div class="home-feature">
      <div class="signal-art" aria-hidden="true">
        <Image src={neuralTides} class="hero-artwork" widths={[480, 800, 1200, 1728]} sizes="(max-width: 760px) 100vw, (max-width: 1600px) 50vw, 800px" format="webp" quality={90} alt="" loading="eager" fetchpriority="high" />
      </div>
      <section class="next-event" aria-labelledby="next-event-label">
        <div class="next-event-copy">
          <p id="next-event-label" class="home-eyebrow"><span>{nextEvent ? `Next ${nextEvent.data.type}` : 'Seminar series'}</span></p>
          {nextEvent ? (
            <>
              <h2><a href={url(`events/${nextEvent.id}/`)}>{nextEvent.data.title}</a></h2>
              {nextEvent.data.speaker && <p class="event-speaker">{nextEvent.data.speaker}</p>}
              <p class="event-details">{formatWhen(nextEvent)}</p>
              <a class="event-link" href={url(`events/${nextEvent.id}/`)}>View event →</a>
            </>
          ) : (
            <>
              <h2>The next conversation starts here.</h2>
              <p class="event-details">{slotLine}. The next speaker will be announced here.</p>
              <a class="event-link" href={routes.follow}>Follow the seminars →</a>
            </>
          )}
        </div>
        {nextEvent && (
          <time class="event-date" datetime={ymd(nextEvent.data.date)} aria-label={formatDate(nextEvent.data.date)}>
            <strong>{String(nextEvent.data.date.getUTCDate()).padStart(2, '0')}</strong>
            <span>{formatDate(nextEvent.data.date, { weekday: undefined, day: undefined, year: undefined })}</span>
          </time>
        )}
      </section>
    </div>
  </section>

  <section class="community-strip" aria-label="Explore the community">
    <p class="community-audience">For students,<br />research staff,<br />postdocs and faculty.</p>
    <a href={url('labs/')}><strong>Meet the labs <span>↗</span></strong><span>Discover research across the region.</span></a>
    <a href={url('events/')}><strong>Join the conversation <span>↗</span></strong><span>Ask questions and share ideas.</span></a>
    <a href={url('positions/')}><strong>Find opportunities <span>↗</span></strong><span>Find openings across the network.</span></a>
  </section>

  <div class="home-content">
    <section class="network-overview" aria-labelledby="across-the-bay">
      <div class="network-overview-copy">
        <p class="home-eyebrow">01 / Across the bay</p>
        <h2 id="across-the-bay">Different labs.<br />A shared conversation.</h2>
        <p class="network-description">Our network connects labs in the Greater Bay Area and beyond that study brains, behaviour and intelligent systems. We bring together computational modelling, experimental neuroscience, psychology and machine intelligence so researchers can share methods and learn from one another.</p>
        <p class="network-description">Through seminars and shared learning resources, we help people meet colleagues beyond their own lab. Students, research staff, postdocs and faculty are welcome, whether you are new to the field or have worked in it for many years. Join a seminar, ask a question, share an approach or explore a collaboration.</p>
        {network.name_native && <p class="network-native" lang="zh">{network.name_native}</p>}
        <p class="network-cities">{cityLine}</p>
        <div class="network-links">
          <a class="btn primary" href={url('join/')}>Join as a lab ↗</a>
          <a class="btn" href={url('about/')}>About the network →</a>
          <span>No fees · All career stages welcome</span>
        </div>
      </div>
      <GreaterBayMap class="network-map" />
    </section>

    {!founding && (
      <section class="stats" aria-label="Network at a glance">
        <div class="stat"><div class="n">{members.length}</div><div class="l">{plural(members.length, 'member lab', 'member labs')}</div></div>
        <div class="stat"><div class="n">{institutions.length}</div><div class="l">{plural(institutions.length, 'institution', 'institutions')}</div></div>
        <div class="stat"><div class="n">{cities.length}</div><div class="l">{plural(cities.length, 'city', 'cities')}</div></div>
        <div class="stat"><div class="n">{talksHeld}</div><div class="l">{plural(talksHeld, 'seminar held', 'seminars held')}</div></div>
      </section>
    )}

    <section class="home-labs" aria-labelledby="participating-labs">
      <div class="section-head">
        <div><p class="home-eyebrow">02 / The community</p><h2 id="participating-labs">Participating labs</h2></div>
        <a href={url('labs/')}>Explore all labs ↗</a>
      </div>
      {showcase.length > 0 ? (
        <>
          <div class="lab-grid sample">
            {showcase.map((lab) => <LabCard lab={lab} compact />)}
          </div>
          {/* Shuffle targets its previous sibling: keep it next to the grid. */}
          <Shuffle />
        </>
      ) : (
        <p class="quiet">No labs are listed yet. <a href={url('join/')}>Add your lab.</a></p>
      )}
      {founding && cities.length > 0 && (
        <p class="small muted founding-note">Member labs are in {citySentence}. Affiliate labs from around the world are welcome.</p>
      )}
    </section>

    {upcoming.length > 1 && (
      <section class="home-more-events" aria-labelledby="more-events">
        <div class="section-head"><h2 id="more-events">More upcoming events</h2><a href={url('events/')}>All events →</a></div>
        <ul class="rows">{upcoming.slice(1, 3).map((event) => <EventRow event={event} />)}</ul>
      </section>
    )}

  {recentSpeakers.length > 0 && (
    <>
      <div class="section-head">
        <h2>Recent speakers</h2>
        <a href={url('events/#past')}>Past events</a>
      </div>
      <ul class="inline-list">
        {recentSpeakers.map((e) => (
          <li>
            <a href={url(`events/${e.id}/`)}>{speakerLine(e)}</a>
            <span class="tiny muted"> {formatDate(e.data.date, { weekday: undefined, day: undefined })}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  {news.length > 0 && (
    <>
      <div class="section-head">
        <h2>News</h2>
        <a href={url('news/')}>All news</a>
      </div>
      <ul class="rows">
        {news.map((entry) => (
          <li class="row">
            <div class="when"><b>{formatDate(entry.data.date, { weekday: undefined })}</b></div>
            <div class="title"><a href={url(`news/#${entry.id}`)}>{entry.data.title}</a></div>
          </li>
        ))}
      </ul>
    </>
  )}

  </div>
</Base>
