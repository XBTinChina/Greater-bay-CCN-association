---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Raster from '../components/Raster.astro';
import LabCard from '../components/LabCard.astro';
import EventRow from '../components/EventRow.astro';
import { network, forms, routes, founding, slotLine } from '../lib/network';
import { url, absolute } from '../lib/url';
import { publishedLabs, institutionsOf } from '../lib/labs';
import { publishedEvents, isUpcoming, byDateAsc, byDateDesc, formatDate, speakerLine } from '../lib/events';

const labs = await publishedLabs();
const members = labs.filter((l) => l.data.tier === 'member');
const institutions = institutionsOf(members);
const cities = new Set(members.map((l) => l.data.city));

const events = await publishedEvents();
const upcoming = events.filter((e) => isUpcoming(e)).sort(byDateAsc);
const past = events.filter((e) => !isUpcoming(e)).sort(byDateDesc);
const talksHeld = past.filter((e) => e.data.type === 'seminar').length;
const recentSpeakers = past.filter((e) => e.data.speaker).slice(0, 6);

const newest = [...labs].sort((a, b) => b.data.joined.getTime() - a.data.joined.getTime()).slice(0, 6);
const news = (await getCollection('news', (n) => !n.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: network.name,
  alternateName: [network.acronym, network.short_name, network.name_native].filter(Boolean),
  url: absolute(''),
  logo: absolute('logo.svg'),
  description: network.tagline,
  areaServed: 'Guangdong-Hong Kong-Macao Greater Bay Area',
  sameAs: [network.repo_url],
  ...(network.contact_email ? { email: network.contact_email } : {}),
};
---

<Base hideBanner jsonld={jsonld}>
  <section class="hero">
    <div>
      <div class="kicker">Hong Kong · Shenzhen · Guangzhou · Macau</div>
      <h1 class="identity">
        <span class="acronym">{network.acronym}</span>
        <span class="fullname">{network.name}</span>
      </h1>
      <p class="lead">{network.tagline}</p>
      {network.pitch && <p class="pitch">{network.pitch}</p>}
      {network.tagline_native && <p class="native" lang="zh">{network.tagline_native}</p>}
      <div class="actions">
        <a class="btn primary" href={url('join/')}>{founding ? 'Join the founding cohort' : 'Join as a lab'}</a>
        <a class="btn" href={routes.follow}>Follow the seminars</a>
      </div>
      <ul class="inline-list commitments" aria-label="Terms of membership">
        <li>No fees</li>
        <li>Membership by lab</li>
        <li>Open to students and postdocs</li>
      </ul>
    </div>
    <Raster class="raster" />
  </section>

  {!founding && (
    <section class="stats" aria-label="Network at a glance">
      <div class="stat"><div class="n">{members.length}</div><div class="l">{plural(members.length, 'member lab', 'member labs')}</div></div>
      <div class="stat"><div class="n">{institutions.length}</div><div class="l">{plural(institutions.length, 'institution', 'institutions')}</div></div>
      <div class="stat"><div class="n">{cities.size}</div><div class="l">{plural(cities.size, 'city', 'cities')}</div></div>
      <div class="stat"><div class="n">{talksHeld}</div><div class="l">{plural(talksHeld, 'seminar held', 'seminars held')}</div></div>
    </section>
  )}

  {!founding && institutions.length > 0 && (
    <ul class="inline-list" aria-label="Participating institutions">
      {institutions.map((i) => (
        <li title={`${i.name} · ${i.count} ${plural(i.count, 'lab', 'labs')}`}>{i.short}</li>
      ))}
    </ul>
  )}

  <section class="trio" aria-label="What member labs get">
    <div>
      <strong>A wider audience</strong>
      <p>Invite speakers on behalf of a regional community rather than a single lab or department.</p>
    </div>
    <div>
      <strong>Easier regional connections</strong>
      <p>Find labs, methods, facilities, collaborators, students and expertise across nearby cities.</p>
    </div>
    <div>
      <strong>Shared training and opportunities</strong>
      <p>Circulate tutorials, summer schools, positions, datasets and practical know-how across institutions.</p>
    </div>
  </section>

  <div class="section-head">
    <h2>{upcoming.length > 0 ? 'Next event' : 'Seminars'}</h2>
    <a href={url('events/')}>All events</a>
  </div>
  {upcoming.length > 0 ? (
    <ul class="rows">
      {upcoming.slice(0, 2).map((e, i) => <EventRow event={e} featured={i === 0} />)}
    </ul>
  ) : (
    <p class="quiet">
      {founding
        ? 'The first event will be a founding roundtable, where each founding lab introduces itself and the seminar format is agreed. '
        : 'To be announced. '}
      {slotLine}. <a href={routes.follow}>Follow the seminars</a> or{' '}
      <a href={routes.nominateEmail || forms.nomination}>nominate a speaker</a>.
    </p>
  )}

  {recentSpeakers.length > 0 && (
    <>
      <div class="section-head">
        <h2>Recent speakers</h2>
        <a href={url('events/#past')}>Recordings</a>
      </div>
      <ul class="inline-list">
        {recentSpeakers.map((e) => (
          <li>
            <a href={url(`events/${e.id}/`)}>{speakerLine(e)}</a>
            <span class="tiny muted"> {formatDate(e.data.date, { weekday: undefined, day: undefined })}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="section-head">
    <h2>{founding ? 'Founding labs' : 'Labs'}</h2>
    <a href={url('labs/')}>All labs</a>
  </div>
  {newest.length > 0 ? (
    <div class="lab-grid">
      {newest.map((lab) => <LabCard lab={lab} compact />)}
    </div>
  ) : (
    <p class="quiet">The first labs are joining now. <a href={url('join/')}>Be one of them.</a></p>
  )}
  {founding && newest.length > 0 && (
    <p class="small muted" style="margin-top:1.2rem">
      Founding labs are being confirmed across Hong Kong, Shenzhen, Guangzhou and Macau; the roster grows as they join.
    </p>
  )}

  {news.length > 0 && (
    <>
      <div class="section-head">
        <h2>News</h2>
        <a href={url('news/')}>All news</a>
      </div>
      <ul class="rows">
        {news.map((entry) => (
          <li class="row">
            <div class="when"><b>{formatDate(entry.data.date, { weekday: undefined })}</b></div>
            <div class="title"><a href={url(`news/#${entry.id}`)}>{entry.data.title}</a></div>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>
