---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" noindex>
  <h1>Page not found</h1>
  <p class="muted">The page may have moved when an event or lab was renamed.</p>
  <div class="actions">
    <a class="btn" href={url('')}>Home</a>
    <a class="btn" href={url('labs/')}>Labs</a>
    <a class="btn" href={url('events/')}>Seminars</a>
  </div>
</Base>
