---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" noindex>
  <h1>Page not found</h1>
  <p class="lead">This page may have moved or the link may be out of date. Use the links below to continue.</p>
  <div class="actions">
    <a class="btn" href={url('')}>Home</a>
    <a class="btn" href={url('labs/')}>Labs</a>
    <a class="btn" href={url('events/')}>Seminars</a>
  </div>
</Base>
