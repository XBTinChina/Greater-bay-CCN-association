---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { forms, network, routes } from '../../lib/network';
import { url } from '../../lib/url';
import { formatDate } from '../../lib/events';
import { POSITION_TYPE_LABELS } from '../../lib/taxonomy';

const now = new Date();
const all = await getCollection('positions', (p) => !p.data.draft);
const open = all
  .filter((p) => {
    const until = p.data.expires ?? p.data.deadline;
    return !until || until.getTime() + 24 * 60 * 60 * 1000 >= now.getTime();
  })
  .sort((a, b) => {
    const da = a.data.deadline?.getTime() ?? Number.POSITIVE_INFINITY;
    const db = b.data.deadline?.getTime() ?? Number.POSITIVE_INFINITY;
    return da - db || b.data.posted.getTime() - a.data.posted.getTime();
  });
const rendered = await Promise.all(open.map(async (p) => ({ p, Content: (await render(p)).Content })));
---

<Base title="Positions" description="PhD, postdoc, research assistant and faculty openings in computational and cognitive neuroscience labs across the Greater Bay Area.">
  <h1>Positions</h1>
  <p class="lead">
    Openings in member and affiliate labs: PhD, postdoc, research assistant and faculty. One board for the whole region;
    listings leave on their deadline.
  </p>
  <div class="actions" style="margin-top:0.5rem">
    <a class="btn primary" href={forms.position}>Post a position</a>
    <a class="btn" href={routes.follow}>Follow the seminars</a>
  </div>
  <p class="small muted">
    Any member or affiliate lab may post. The form needs a free GitHub account
    {network.contact_email ? <>, or <a href={`mailto:${network.contact_email}?subject=${encodeURIComponent('[Position] New opening')}`}>email the listing</a> to the coordinators</> : ''}.
    A coordinator checks it and it appears within days.
  </p>

  {rendered.length === 0 ? (
    <p class="quiet">No open positions right now. Labs joining the founding cohort will post theirs here.</p>
  ) : (
    <ul class="rows">
      {rendered.map(({ p, Content }) => (
        <li class="row">
          <div class="when">
            <b>{POSITION_TYPE_LABELS[p.data.type]}</b>
            <span>{p.data.deadline ? `Deadline ${formatDate(p.data.deadline, { weekday: undefined })}` : 'Open until filled'}</span>
            <span><br />posted {formatDate(p.data.posted, { weekday: undefined })}</span>
          </div>
          <div>
            <div class="title">{p.data.url ? <a href={p.data.url}>{p.data.title}</a> : p.data.title}</div>
            <div class="sub">
              {p.data.pi && `${p.data.pi} · `}
              {p.data.institution} · {p.data.city}
            </div>
            <div class="prose small" style="margin-top:0.5rem"><Content /></div>
            {(p.data.url || p.data.contact_email) && (
              <div class="links">
                {p.data.url && <a href={p.data.url}>How to apply</a>}
                {p.data.contact_email && <a href={`mailto:${p.data.contact_email}`}>Contact</a>}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}

  <p class="small muted" style="margin-top:2.5rem">
    Looking for people rather than a post? Member labs list what they are looking for on the <a href={url('labs/')}>labs page</a>.
  </p>
</Base>
