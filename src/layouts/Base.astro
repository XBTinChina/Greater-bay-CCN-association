---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { network, forms } from '../lib/network';
import { url, absolute } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** For pages that should not be indexed or given a canonical URL, such as the 404 page. */
  noindex?: boolean;
}

const { title, description = network.tagline, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${network.short_name}` : network.name;

const nav: Array<[string, string]> = [
  ['Labs', 'labs/'],
  ['Seminars', 'events/'],
  ['Learning', 'tutorials/'],
  ['Positions', 'positions/'],
  ['Join', 'join/'],
  ['About', 'about/'],
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (path: string) => current.startsWith(url(path));
const canonical = absolute(current.replace(/^\/+/, '').replace(new RegExp(`^${url('').replace(/^\//, '')}`), ''));
// The banner is authored in data/network.yml with site-relative links like
// href="join/"; prefix them with the base so they work on every page.
const banner = network.status_banner?.replace(
  /href="(?!https?:|mailto:|#)\/?([^"]*)"/g,
  (_m, path: string) => `href="${url(path)}"`,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="text/calendar" title={`${network.short_name} events`} href={url('calendar.ics')} />
    <meta property="og:site_name" content={network.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#15171c" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="band" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url('')}>
          <Mark />
          <span>{network.short_name}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map(([label, path]) => (
            <a href={url(path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    {banner && (
      <div class="notice">
        <div class="container" set:html={banner} />
      </div>
    )}
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="row">
          <div>
            {network.name}
            {network.name_native && <> · <span lang="zh">{network.name_native}</span></>}
          </div>
          <div class="links">
            <a href={url('join/')}>Join</a>
            <a href={forms.nomination}>Nominate a speaker</a>
            <a href={url('calendar.ics')}>Calendar</a>
            <a href={url('docs/')}>Documents</a>
            <a href={network.repo_url}>GitHub</a>
            {network.contact_email ? (
              <a href={`mailto:${network.contact_email}`}>Email</a>
            ) : (
              <a href={forms.issues}>Contact</a>
            )}
          </div>
        </div>
        <div class="row" style="margin-top:0.6rem">
          <span class="tiny">Code MIT · content CC BY 4.0 · built to load from both sides of the border</span>
        </div>
      </div>
    </footer>
  </body>
</html>
