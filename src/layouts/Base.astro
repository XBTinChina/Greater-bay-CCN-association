---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { network, forms, routes, founding } from '../lib/network';
import { submitForm } from '../lib/submit';
import { url, absolute } from '../lib/url';
import { brand, hasBrand } from '../lib/brand';

interface Props {
  title?: string;
  description?: string;
  /** For pages that should not be indexed or given a canonical URL, such as the 404 page. */
  noindex?: boolean;
  /** The home page carries the message itself, so it hides the notice line. */
  hideBanner?: boolean;
  /** Structured data (schema.org) for this page. */
  jsonld?: Record<string, unknown>;
}

const { title, description = network.tagline, noindex = false, hideBanner = false, jsonld } = Astro.props;
const fullTitle = title ? `${title} · ${network.short_name}` : network.name;

// Resources (training material) appears in the navigation once there is
// something in it; Positions is always there so labs can post openings.
const tutorialCount = (await getCollection('tutorials', (t) => !t.data.draft)).length;

const nav: Array<[string, string]> = [
  ['Labs', 'labs/'],
  ['Events', 'events/'],
  ['Positions', 'positions/'],
  ...(tutorialCount > 0 ? ([['Resources', 'resources/']] as Array<[string, string]>) : []),
  ['About', 'about/'],
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (path: string) => current.startsWith(url(path));
const canonical = absolute(current.replace(/^\/+/, '').replace(new RegExp(`^${url('').replace(/^\//, '')}`), ''));
// The banner is authored in data/network.yml with site-relative links like
// href="join/"; prefix them with the base so they work on every page.
const banner = network.status_banner?.replace(
  /href="(?!https?:|mailto:|#)\/?([^"]*)"/g,
  (_m, path: string) => `href="${url(path)}"`,
);
const ogImage = absolute('og.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {hasBrand ? (
      <>
        <link rel="icon" href={url('favicon.png')} type="image/png" sizes="64x64" />
        <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
      </>
    ) : (
      <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    )}
    <link rel="alternate" type="text/calendar" title={`${network.short_name} events`} href={url('calendar.ics')} />
    <link rel="alternate" type="application/rss+xml" title={`${network.short_name} news and events`} href={url('feed.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:site_name" content={network.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${network.acronym}: ${network.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#15171c" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="band" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url('')}>
          {hasBrand ? (
            <picture>
              {brand.markLight && <source srcset={brand.markLight} media="(prefers-color-scheme: dark)" />}
              <img src={brand.mark} alt="" width="42" height="42" class="brand-mark" />
            </picture>
          ) : (
            <Mark />
          )}
          <span>{network.short_name}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map(([label, path]) => (
            <a href={url(path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>
          ))}
          <a class="follow" href={routes.follow} title="Follow the seminars">Follow</a>
          <a class="btn small primary" href={url('join/')} aria-current={isCurrent('join/') ? 'page' : undefined}>
            {founding ? 'Join the founding cohort' : 'Join'}
          </a>
        </nav>
      </div>
    </header>
    {banner && !hideBanner && (
      <div class="notice">
        <div class="container" set:html={banner} />
      </div>
    )}
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="row">
          <div>
            {network.name}
            {network.name_native && <> · <span lang="zh">{network.name_native}</span></>}
          </div>
          <div class="links">
            <a href={url('join/')}>Join</a>
            <a href={routes.nominateEmail || submitForm('nomination')}>Nominate a speaker</a>
            <a href={url('calendar.ics')}>Calendar</a>
            <a href={url('feed.xml')}>Feed</a>
            <a href={url('docs/')}>Documents</a>
            <a href={network.repo_url}>GitHub</a>
            {network.contact_email ? (
              <a href={`mailto:${network.contact_email}`}>Email</a>
            ) : (
              <a href={forms.issues}>Contact</a>
            )}
          </div>
        </div>
        <div class="row" style="margin-top:0.6rem">
          <span class="tiny">Code MIT · text CC BY 4.0 · designed to minimise cross-border dependencies</span>
        </div>
      </div>
    </footer>
  </body>
</html>
