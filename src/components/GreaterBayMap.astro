---
import { Image } from 'astro:assets';
import bayCartoon from '../assets/brand/bay-cartoon.png';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
// The user's original artwork remains intact. Show the complete square in the
// thumbnail and link to the unchanged original for viewing its finer details.
---

<a class={cls} href={bayCartoon.src} aria-label="View the full Greater Bay Area illustration">
  <Image
    src={bayCartoon}
    width={384}
    height={384}
    format="webp"
    quality={90}
    alt="A cartoon bay with green shores, bridges, cities, neuron trees and brain scientists"
    loading="eager"
  />
  <span class="bay-caption">
    Greater<br />Bay Area
    <small>View full map ↗</small>
  </span>
</a>
