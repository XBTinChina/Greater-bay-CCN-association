---
import { url } from '../lib/url';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const mapUrl = url('greater-bay-area.svg');
// Scalable, geographically grounded overview covering all eleven GBA cities.
---

<a class={cls} href={mapUrl} aria-label="View the full map of all eleven Greater Bay Area cities">
  <img
    src={mapUrl}
    width={960}
    height={820}
    alt="Greater Bay Area map showing Guangzhou, Shenzhen, Hong Kong, Macau, Zhuhai, Foshan, Dongguan, Huizhou, Zhongshan, Jiangmen and Zhaoqing"
    loading="lazy"
    decoding="async"
  />
  <span class="bay-caption">
    <span>Greater Bay Area</span>
    <small>View full map ↗</small>
  </span>
</a>
