---
import { Image } from 'astro:assets';
import bayIllustration from '../assets/brand/bay-illustration.png';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
// Show the full illustration without cropping, with a link to the larger image.
---

<a class={cls} href={bayIllustration.src} aria-label="View the full Greater Bay Area illustration">
  <Image
    src={bayIllustration}
    width={512}
    height={384}
    format="webp"
    quality={90}
    alt="Stylised Pearl River Delta illustration showing Guangzhou, Shenzhen, Hong Kong, Zhuhai and Macau around the bay"
    loading="lazy"
  />
  <span class="bay-caption">
    <span>Greater Bay Area</span>
    <small>View full map ↗</small>
  </span>
</a>
