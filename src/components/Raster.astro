---
// A spike raster: rows of spike times, one colour per row along the viridis
// colormap. Drawn as inline SVG from a seeded generator, so every build
// produces the same picture and nothing is fetched at runtime.
interface Props {
  rows?: number;
  width?: number;
  height?: number;
  class?: string;
}
const { rows = 12, width = 440, height = 264, class: cls } = Astro.props;

let seed = 20260903;
const rnd = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};

const STOPS = ['#440154', '#414487', '#2a788e', '#22a884', '#7ad151', '#fde725'];
const hex = (c: string) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
const mix = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
function viridis(t: number): string {
  const x = Math.min(Math.max(t, 0), 1) * (STOPS.length - 1);
  const i = Math.min(Math.floor(x), STOPS.length - 2);
  const f = x - i;
  const a = hex(STOPS[i]);
  const b = hex(STOPS[i + 1]);
  return `rgb(${mix(a[0], b[0], f)},${mix(a[1], b[1], f)},${mix(a[2], b[2], f)})`;
}

const rowGap = height / rows;
const tickH = rowGap * 0.58;
const ticks: { x: number; y: number; c: string }[] = [];
for (let r = 0; r < rows; r += 1) {
  const y = rowGap * r + (rowGap - tickH) / 2;
  // Rows sweep from purple to green; the yellow end is kept off the paper.
  const c = viridis(0.04 + (0.84 * r) / Math.max(rows - 1, 1));
  let x = rnd() * 10;
  while (x < width) {
    const burst = x > width * 0.4 && x < width * 0.6;
    x += (burst ? 5 : 13) + rnd() * (burst ? 9 : 34);
    if (x < width - 2) ticks.push({ x: +x.toFixed(1), y: +y.toFixed(1), c });
  }
}
---

<svg
  class={cls}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  {ticks.map((t) => (
    <line x1={t.x} y1={t.y} x2={t.x} y2={t.y + tickH} stroke={t.c} stroke-width="1.7" stroke-linecap="round" />
  ))}
</svg>
