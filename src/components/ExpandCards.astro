---
/**
 * Gives every card whose text is too tall a "Show more" toggle.
 *
 * Mark the card `data-expandable` and the parts of it that may be shortened
 * `data-clampable`. The script adds the `clamp` class, measures, and keeps it
 * only where the content really does overflow, so a short entry gets no button.
 * How a part shortens is the stylesheet's business, not this script's: a lab's
 * one-paragraph description clamps to three lines, a position's rendered
 * Markdown clamps to a height, and both answer scrollHeight the same way.
 *
 * The stylesheet does not clamp on its own, which inverts the failure mode: a
 * reader without JavaScript sees every entry in full rather than a fixed
 * fragment with no way to reach the rest.
 *
 * One toggle per card, controlling every clamped part of it, so a card with
 * both a description and a "Looking for" line does not grow two buttons.
 *
 * Inline and unbundled so it runs during parsing, before the cards are painted:
 * deferred, the clamp would appear as a visible collapse a moment after the
 * page had already drawn the full text. Measuring this early is safe because
 * the site uses system fonts, so line heights are settled at first layout.
 */
---

<script is:inline>
  (function () {
    var cards = document.querySelectorAll('[data-expandable]');
    for (var i = 0; i < cards.length; i++) attach(cards[i]);

    function attach(card) {
      var parts = card.querySelectorAll('[data-clampable]');
      if (!parts.length) return;
      var j;
      for (j = 0; j < parts.length; j++) parts[j].classList.add('clamp');

      var overflows = false;
      // One extra pixel of slack: sub-pixel line heights make an exactly
      // fitting paragraph look like it overflows.
      for (j = 0; j < parts.length; j++) {
        if (parts[j].scrollHeight > parts[j].clientHeight + 1) overflows = true;
      }
      if (!overflows) {
        for (j = 0; j < parts.length; j++) parts[j].classList.remove('clamp');
        return;
      }

      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'more';
      button.setAttribute('aria-expanded', 'false');
      button.textContent = 'Show more';
      button.addEventListener('click', function () {
        var open = button.getAttribute('aria-expanded') === 'true';
        for (var k = 0; k < parts.length; k++) parts[k].classList.toggle('clamp', open);
        button.setAttribute('aria-expanded', open ? 'false' : 'true');
        button.textContent = open ? 'Show more' : 'Show less';
      });
      parts[parts.length - 1].insertAdjacentElement('afterend', button);
    }
  })();
</script>
