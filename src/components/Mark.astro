---
// The same compact network symbol is used in the header, About and posters.
import { url } from '../lib/url';
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: cls } = Astro.props;
---

<img class:list={['brand-mark', cls]} src={url('logo.png')} width={size} height={size} alt="" aria-hidden="true" decoding="async" />
