---
// The mark: three spikes on the viridis scale. Used in the header and the poster.
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: cls } = Astro.props;
---

<svg class={cls} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="7" fill="currentColor" />
  <g stroke-width="3" stroke-linecap="round">
    <line x1="9.5" y1="21" x2="9.5" y2="13" stroke="#5b3a8c" />
    <line x1="16" y1="24" x2="16" y2="8" stroke="#21918c" />
    <line x1="22.5" y1="21" x2="22.5" y2="15.5" stroke="#9ad83b" />
  </g>
</svg>
