---
import type { LabEntry } from '../lib/labs';
import { labName, initials, institutionShort } from '../lib/labs';
import { url } from '../lib/url';

interface Props {
  lab: LabEntry;
  /** Home-page variant: name, place and three topics; no description or links. */
  compact?: boolean;
}
const { lab, compact = false } = Astro.props;
const d = lab.data;
const name = labName(lab);
const topics = compact ? d.keywords.slice(0, 3) : d.keywords;
---

<article
  class="lab"
  data-city={d.city}
  data-institution={d.institution}
  data-tier={d.tier}
  data-text={[d.pi, d.pi_native ?? '', name, d.institution, d.department ?? '', d.description ?? '', ...d.keywords]
    .join(' ')
    .toLowerCase()}
>
  {d.photo ? (
    <img class="avatar" src={url(`photos/${d.photo}`)} alt={`Photo of ${d.pi}`} width="52" height="52" loading="lazy" />
  ) : (
    <div class="avatar" aria-hidden="true">{initials(d.pi)}</div>
  )}
  <div>
    <div class="name">
      {d.website ? <a href={d.website}>{d.pi}</a> : d.pi}
      {d.pi_native && <span class="native">{d.pi_native}</span>}
      {d.tier === 'affiliate' && <span class="tag">Affiliate</span>}
    </div>
    <div class="where">
      {name !== `${d.pi} Lab` && <>{name} · </>}
      <span title={d.institution}>{institutionShort(lab)}</span> · {d.city}
    </div>
    <div class="topics">{topics.join(' · ')}</div>
    {!compact && d.description && <p class="desc">{d.description}</p>}
    {!compact && d.looking_for && (
      <p class="desc muted">
        <strong>Looking for:</strong> {d.looking_for}
      </p>
    )}
    {!compact && (d.website || d.orcid || d.profile || d.scholar || d.github || d.email) && (
      <div class="links">
        {d.website && <a href={d.website}>Website</a>}
        {d.orcid && <a href={d.orcid}>ORCID</a>}
        {d.profile && <a href={d.profile}>Profile</a>}
        {d.scholar && <a href={d.scholar}>Scholar</a>}
        {d.github && <a href={d.github}>GitHub</a>}
        {d.email && <a href={`mailto:${d.email}`}>Email</a>}
      </div>
    )}
  </div>
</article>
